# frps on distroless: upstream's binary, without a shell. The tag and digest move together with the
# github.com/fatedier/frp version in go.mod (Renovate groups them).
FROM ghcr.io/fatedier/frps:v0.71.0@sha256:cd8b947ba61678b200baa4f71ccc33f3c52e4e2cc0059700ba3b8354e36af7c3 AS frps

FROM gcr.io/distroless/static:nonroot@sha256:d62067879de890a1def9da0e7766b7d20810a5e5555cef8506b752437d7a3e88
COPY --from=frps /usr/bin/frps /usr/bin/frps
ENTRYPOINT ["/usr/bin/frps"]
