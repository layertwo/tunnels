# frps on distroless: upstream's binary, without a shell. The tag and digest move together with the
# github.com/fatedier/frp version in go.mod (Renovate groups them).
FROM ghcr.io/fatedier/frps:v0.72.0@sha256:17abb20dd392557a44070d9726954630c0eb1f7a9bd6ead5ae9150d165179ea4 AS frps

FROM gcr.io/distroless/static:nonroot@sha256:aafe993665bf6200db38a02c11a9351e782a84b6a45e7f33b6695638c88e3931
COPY --from=frps /usr/bin/frps /usr/bin/frps
ENTRYPOINT ["/usr/bin/frps"]
